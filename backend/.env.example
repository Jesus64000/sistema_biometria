# =========================================================================
# PLANTILLA DE CONFIGURACIÓN DEL ENTORNO - MARIAN GYM (BACKEND)
# =========================================================================
# Instrucciones: Copia este archivo como '.env' en esta misma carpeta y rellena tus datos.
# NOTA: No expongas contraseñas de producción en este archivo plantilla.

# Puerto en el que corre el servidor backend de Express
PORT=3000

# Conexión a la base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=sistema_biometria

# Secreto JWT para la firma de tokens de autenticación (Cambiar por uno largo y seguro en producción)
JWT_SECRET=tu_secreto_jwt_super_seguro_y_largo_aqui

# URL de comunicación con el microservicio de Inteligencia Artificial (Flask OpenCV)
PYTHON_BIOMETRICS_URL=http://127.0.0.1:5000
